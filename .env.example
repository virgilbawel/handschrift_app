# Verplicht: je Anthropic API-sleutel (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optioneel — standaardwaarden staan erachter
FREE_LIMIT=3              # max. gratis transcripties per e-mailadres
IP_DAILY_LIMIT=15         # max. transcripties per IP-adres per 24 uur (tegen misbruik met nep-adressen)
MODEL=claude-opus-5       # Claude-model voor de transcriptie
DATA_DIR=./data           # map waar emails.json wordt opgeslagen
ADMIN_TOKEN=              # zet een lang geheim wachtwoord om de e-maillijst te downloaden via /api/admin/emails.csv
PORT=3000
